# =============================================================================
# Profitable Trading Bot - Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit your real .env file to version control.
# =============================================================================

# Runtime mode: paper | testnet | live
# Always start in "paper" or "testnet" before risking real capital.
TRADING_MODE=paper

# Exchange settings (Binance via ccxt)
EXCHANGE_NAME=binance
MARKET_TYPE=spot                # spot | futures
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
DEFAULT_LEVERAGE=1              # Used when MARKET_TYPE=futures (keep low!)

# Trading universe & cadence
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
STRATEGY_NAME=composite         # trend_following | moving_average | composite
POLL_INTERVAL_SECONDS=30
INITIAL_CAPITAL=10000.0

# Strategy parameters
EMA_FAST_PERIOD=12
EMA_SLOW_PERIOD=26
EMA_TREND_PERIOD=200
RSI_PERIOD=14
RSI_OVERBOUGHT=70.0
RSI_OVERSOLD=30.0
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Risk management
RISK_PER_TRADE_PCT=0.01         # Risk 1% of equity per trade
MAX_POSITION_PCT=0.25           # Max 25% of equity in a single position
MAX_OPEN_POSITIONS=3
STOP_LOSS_PCT=0.02              # 2% default stop loss (or ATR-based)
TAKE_PROFIT_PCT=0.04            # 4% default take profit (2:1 R:R)
TRAILING_STOP_PCT=0.015         # 1.5% trailing stop once in profit
USE_ATR_STOPS=true
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=4.0
MAX_DAILY_LOSS_PCT=0.03         # Halt new entries after 3% daily loss
MAX_DRAWDOWN_PCT=0.10           # Kill-switch at 10% peak-to-trough drawdown
MAX_CONSECUTIVE_LOSSES=4

# Execution simulation (paper & backtest)
FEE_RATE=0.001                  # 0.10% Binance spot fee
SLIPPAGE_PCT=0.0005             # 0.05% estimated slippage

# Database & Cache
DATABASE_URL=sqlite:///./trading_bot.db
# For PostgreSQL (used automatically in docker-compose):
# DATABASE_URL=postgresql+psycopg2://trader:trader_password@postgres:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Monitoring & Alerts (optional)
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text | json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
